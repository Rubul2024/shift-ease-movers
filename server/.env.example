# Copy to .env and adjust. Never commit .env.
NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/shiftease_movers

# Required in production: at least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Origins allowed to call the API cross-origin (comma-separated).
# Leave empty when Express serves the React build itself (same origin).
CLIENT_URL=http://localhost:3000

# Set to 1 when running behind a reverse proxy / PaaS load balancer (Render, Railway, Nginx).
TRUST_PROXY=

# Admin created by `npm run seed` (ADMIN_PASSWORD is required when NODE_ENV=production)
ADMIN_EMAIL=admin@shiftease.com
ADMIN_PASSWORD=Admin@123
# Set to true to also create the demo customer account in production
SEED_DEMO_CUSTOMER=false
