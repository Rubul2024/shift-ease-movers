# Copy to .env and adjust. Never commit .env.
NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/shiftease_movers

# Required in production: at least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Origins allowed to call the API cross-origin (comma-separated).
# Leave empty when Express serves the React build itself (same origin).
CLIENT_URL=http://localhost:3000

# Set to 1 when running behind a reverse proxy / PaaS load balancer (Render, Railway, Nginx).
TRUST_PROXY=

# Admin created by `npm run seed` (ADMIN_PASSWORD is required when NODE_ENV=production)
ADMIN_EMAIL=admin@shiftease.com
ADMIN_PASSWORD=Admin@123
# Set to true to also create the demo customer account in production
SEED_DEMO_CUSTOMER=false

# Public URL of the website, used in email links (e.g. https://shiftease.in).
# If empty, the request's Origin header is used.
APP_URL=

# ---- Email (optional) ----
# Booking confirmations, status updates, quote emails, inquiry alerts and password resets.
# Without SMTP_HOST, emails are printed to the console in development and skipped in production.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="ShiftEase Movers <no-reply@shiftease.in>"
COMPANY_NAME=ShiftEase Movers
# New website inquiries are forwarded here
ADMIN_NOTIFY_EMAIL=
